* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  min-height: 100%;
}

body {
  background: #f5f7fb;
  font-family: Arial, Helvetica, sans-serif;
  color: #172033;
}

button {
  font-family: inherit;
}

.app {
  width: 100%;
  max-width: 520px;
  min-height: 100vh;
  margin: auto;
  padding-bottom: 90px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 18px;
  background: white;
}

.header h1 {
  font-size: 23px;
}

.header p {
  margin-top: 5px;
  color: #777;
  font-size: 14px;
}

.avatar {
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ff;
  border-radius: 50%;
  font-size: 23px;
}

.balance-card {
  margin: 16px;
  padding: 22px;
  border-radius: 20px;
  background: #182848;
  color: white;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

.balance-card p {
  opacity: 0.8;
  font-size: 14px;
}

.balance-card h2 {
  margin: 10px 0 18px;
  font-size: 32px;
}

.balance-info {
  display: flex;
  justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.content {
  padding: 0 16px;
}

.section-title {
  margin: 22px 0 14px;
  font-size: 20px;
}

.menu-card,
.task-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 17px;
  margin-bottom: 12px;
  background: white;
  border-radius: 16px;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
}

.icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f4ff;
  border-radius: 14px;
  font-size: 24px;
}

.menu-card h3,
.task-card h3 {
  font-size: 16px;
}

.menu-card p,
.task-card p {
  margin-top: 5px;
  color: #777;
  font-size: 13px;
}

.task-card > span {
  width: 45px;
  font-size: 25px;
  text-align: center;
}

.join-box {
  margin-top: 18px;
  padding: 20px;
  background: white;
  border-radius: 18px;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
}

.join-box h3 {
  margin-bottom: 8px;
}

.join-box p {
  color: #777;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 15px;
}

.join-box button {
  width: 100%;
  padding: 13px;
  margin-top: 9px;
  border: 0;
  border-radius: 12px;
  background: #eef2ff;
  color: #182848;
  font-weight: bold;
  font-size: 14px;
}

.join-box .verify-button {
  background: #182848;
  color: white;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 520px;
  display: flex;
  justify-content: space-around;
  padding: 10px 8px;
  background: white;
  border-top: 1px solid #eee;
}

.bottom-nav button {
  flex: 1;
  border: 0;
  background: transparent;
  color: #777;
  padding: 6px;
  font-size: 12px;
}

.bottom-nav span {
  display: block;
  margin-bottom: 4px;
  font-size: 20px;
}

.bottom-nav .active {
  color: #182848;
  font-weight: bold;
}
